{% from "_components/blog/document-head" import DocumentHead %}
{% from "_components/blog/global-header" import GlobalHeader %}
{% from "_components/blog/document-foot" import DocumentFoot %}
{% from "_components/blog/global-footer" import GlobalFooter %}

{{ DocumentHead() }}

{{ GlobalHeader() }}

    <main id="main">
        <article>
            <section class="layout-section">
                <ul class="layout-grid">
                    {% set entries = craft.entries()
                        .section('blog')
                        .limit(10)
                        .all()
                    %}

                    {% for entry in entries %}
                        <li>
                            <a href="{{ entry.url() }}" class="card-preview">
                                <h2 class="h">{{ entry.title }}</h2>
                                <small class="date">{{ entry.postDate | date('F j, Y') }}</small>
                                <p class="summary">{{ entry.postSummary }}</p>
                                <span class="button">Read Post</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </article>
    </main>
    
{{ GlobalFooter() }}

{{ DocumentFoot() }}

{# 
    entry: craft entry object
 #}
{% macro DocumentHead(entry) %}
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% if entry is not null %}{{ entry.title }} | {% endif %}A Front-End Web Development Blog by Kristen Grote</title>
        <link rel="alternate" type="application/atom+xml" href="{{ url('feeds/blog') }}">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="{{ rev('/assets/css/blog.css') }}">
        <link rel="stylesheet" href="{{ rev('/assets/css/plugins/prism.css') }}">
        {% if entry is not null %}
            <meta property="og:title" content="{{ entry.title }}" />
            <meta property="og:url" content="{{ entry.url() }}" />
            {% if entry.postSummary %}
                <meta property="og:description" content="{{ entry.postSummary }}" />
            {% endif %}
            {% if entry.socialPreviewImage %}
                <meta property="og:image" content="{{ entry.socialPreviewImage.one.url() }}" />
            {% endif %}
        {% endif %}
    </head>
    <body>
{% endmacro %}